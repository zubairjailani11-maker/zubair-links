<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zubair 😔</title>
    <style>
        /* انیمیشن‌های کلیدی */
        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(3deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
        @keyframes pulse {
            0% { transform: scale(1); opacity: 0.7; }
            50% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); opacity: 0.7; }
        }
        @keyframes rain {
            0% { background-position: 0 0; }
            100% { background-position: 0 600px; }
        }
        @keyframes sadText {
            0% { letter-spacing: 2px; opacity: 0; }
            50% { letter-spacing: 8px; opacity: 0.5; }
            100% { letter-spacing: 2px; opacity: 1; }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0a0a1a;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            /* افکت باران غمگین با CSS */
            background-image: repeating-linear-gradient(
                transparent 0px,
                rgba(255, 255, 255, 0.03) 2px,
                transparent 4px
            );
            background-size: 100% 20px;
            animation: rain 10s linear infinite;
            position: relative;
            overflow: hidden;
        }

        /* دایره‌های نورانی غمگین */
        .glow-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.2;
            animation: float 6s ease-in-out infinite alternate;
        }
        .orb1 {
            width: 300px;
            height: 300px;
            background: #4a1a6b;
            top: -50px;
            left: -100px;
        }
        .orb2 {
            width: 400px;
            height: 400px;
            background: #1a3a6b;
            bottom: -100px;
            right: -100px;
            animation-delay: 2s;
        }
        .orb3 {
            width: 200px;
            height: 200px;
            background: #6b1a2a;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: 4s;
        }

        .card {
            background: rgba(20, 20, 40, 0.7);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 60px 60px 40px 40px;
            padding: 50px 40px 40px;
            width: 380px;
            max-width: 90%;
            text-align: center;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.05);
            z-index: 10;
            animation: float 5s ease-in-out infinite;
            transition: all 0.4s;
        }

        .card:hover {
            transform: scale(1.02);
            border-color: rgba(255, 200, 200, 0.2);
        }

        /* صورتک غمگین با انیمیشن */
        .sad-face {
            font-size: 90px;
            line-height: 1;
            animation: pulse 2.5s ease-in-out infinite;
            display: block;
            margin-bottom: 10px;
            filter: drop-shadow(0 0 30px rgba(100, 50, 150, 0.3));
        }

        h1 {
            color: #e8e0f0;
            font-size: 2.6rem;
            font-weight: 300;
            letter-spacing: 6px;
            margin: 10px 0 5px;
            animation: sadText 3s ease-out;
            text-shadow: 0 0 40px rgba(200, 150, 255, 0.15);
        }

        .sub-sad {
            color: #9a8aaa;
            font-size: 1rem;
            letter-spacing: 3px;
            margin-bottom: 30px;
            opacity: 0.7;
            border-bottom: 1px dashed rgba(255, 255, 255, 0.05);
            padding-bottom: 20px;
            animation: fadeIn 2s;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 0.7; transform: translateY(0); }
        }

        .links {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-top: 10px;
        }

        .link-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 14px 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 50px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            color: #c8c0d8;
            text-decoration: none;
            font-weight: 400;
            letter-spacing: 1.5px;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            backdrop-filter: blur(5px);
            font-size: 1.05rem;
            position: relative;
            overflow: hidden;
        }

        .link-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
            transition: left 0.6s;
        }

        .link-item:hover {
            transform: translateY(-4px) scale(1.02);
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(200, 150, 255, 0.2);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.6);
            color: #f0ecff;
        }

        .link-item:hover::before {
            left: 100%;
        }

        .link-item .icon {
            font-size: 1.5rem;
            width: 30px;
            text-align: center;
            opacity: 0.7;
            transition: 0.3s;
        }

        .link-item:hover .icon {
            opacity: 1;
            transform: rotate(-5deg) scale(1.1);
        }

        /* استایل مخصوص اشک */
        .tear {
            position: fixed;
            font-size: 20px;
            opacity: 0.15;
            pointer-events: none;
            animation: fall linear infinite;
            z-index: 1;
        }

        @keyframes fall {
            0% { transform: translateY(-10vh) rotate(0deg); opacity: 0.2; }
            100% { transform: translateY(110vh) rotate(720deg); opacity: 0; }
        }

        /* زیرنویس غمگین */
        .footer-sad {
            margin-top: 25px;
            color: #5a4a6a;
            font-size: 0.8rem;
            letter-spacing: 2px;
            opacity: 0.5;
            animation: pulse 4s infinite;
        }
    </style>
</head>
<body>
    <!-- دایره‌های نورانی -->
    <div class="glow-orb orb1"></div>
    <div class="glow-orb orb2"></div>
    <div class="glow-orb orb3"></div>

    <!-- کارت اصلی -->
    <div class="card">
        <span class="sad-face">😔</span>
        <h1>Zubair</h1>
        <div class="sub-sad">✦ در غم‌هایت تنها نیستی ✦</div>

        <div class="links">
            <a href="#" class="link-item">
                <span class="icon">📸</span> Instagram
            </a>
            <a href="#" class="link-item">
                <span class="icon">🎵</span> TikTok
            </a>
            <a href="#" class="link-item">
                <span class="icon">🎬</span> CapCut
            </a>
            <a href="#" class="link-item">
                <span class="icon">✈️</span> Telegram
            </a>
        </div>
        <div class="footer-sad">❀ همیشه یک امید هست ❀</div>
    </div>

    <!-- ایجاد اشک‌های مصنوعی با جاوااسکریپت -->
    <script>
        (function createTears() {
            const tearSymbols = ['💧', '•', '⁕', '✧'];
            for (let i = 0; i < 25; i++) {
                const tear = document.createElement('div');
                tear.className = 'tear';
                tear.textContent = tearSymbols[i % tearSymbols.length];
                tear.style.left = Math.random() * 100 + 'vw';
                tear.style.fontSize = (12 + Math.random() * 18) + 'px';
                tear.style.animationDuration = (10 + Math.random() * 20) + 's';
                tear.style.animationDelay = (Math.random() * 15) + 's';
                tear.style.opacity = 0.05 + Math.random() * 0.1;
                document.body.appendChild(tear);
            }
        })();
    </script>
</body>
</html>
